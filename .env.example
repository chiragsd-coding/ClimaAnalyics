# Billing provider configuration — ClimaScope
#
# Fill these ONLY in your private env (process env / deployment secrets).
# NEVER commit real or placeholder secret values to the repository — this
# file documents NAMES ONLY. Billing stays in the honest "being connected"
# state (checkout returns PLANS.billingNote, no fabricated URLs) until a
# provider is selected here AND all of its variables are present.
#
# A user's tier becomes "pro" ONLY via a signature-verified provider webhook:
#   Stripe:   POST /api/billing/webhook/stripe    (checkout.session.completed)
#   Razorpay: POST /api/billing/webhook/razorpay  (payment_link.paid)

# Which provider to use: "stripe" or "razorpay". Unset = billing disabled.
BILLING_PROVIDER=

# --- Stripe (required when BILLING_PROVIDER=stripe) ---
# Secret API key from the Stripe dashboard ( Developers > API keys).
STRIPE_SECRET_KEY=
# Recurring Price object id for the Pro plan (Pro = $99/month, per PLANS).
STRIPE_PRICE_ID=
# Webhook signing secret for the endpoint POST /api/billing/webhook/stripe
# (checkout.session.completed event).
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (required when BILLING_PROVIDER=razorpay) ---
# Key id and key secret from the Razorpay dashboard (Account & Settings > API keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret for the endpoint POST /api/billing/webhook/razorpay
# (payment_link.paid event).
RAZORPAY_WEBHOOK_SECRET=
# Settlement currency for Razorpay amounts (default INR; amount = Pro price x 100 minor units).
RAZORPAY_CURRENCY=
