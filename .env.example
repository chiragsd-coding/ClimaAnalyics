# Billing provider configuration — ClimaScope
#
# This file ships DUMMY placeholder values (all credentials start with DUMMY_).
# The billing gateway treats any value beginning with DUMMY_ as "not
# configured": checkout stays in the honest "billing is being connected" state
# and webhook events never upgrade a tier while placeholders are in place —
# even if signed with the placeholder webhook secret (guard enforced in
# src/lib/billing/index.ts; tested in scripts/billing-test.ts section h2).
#
# To go live: copy this file to .env (gitignored) and replace every DUMMY_
# value with a real credential from your provider dashboard — billing then
# activates with zero code changes. NEVER commit a real credential; this file
# must only ever hold placeholders.
#
# A user's tier becomes "pro" ONLY via a signature-verified provider webhook
# WHILE the selected provider is fully configured with real (non-DUMMY_)
# credentials:
#   Stripe:   POST /api/billing/webhook/stripe    (checkout.session.completed)
#   Razorpay: POST /api/billing/webhook/razorpay  (payment_link.paid)

# Which provider to use: "stripe" or "razorpay". Empty/unset = billing disabled.
BILLING_PROVIDER=stripe

# --- Stripe (required when BILLING_PROVIDER=stripe) ---
# Secret API key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY=DUMMY_replace_with_real_stripe_secret_key
# Recurring Price object id for the Pro plan (Pro = $99/month, per PLANS).
STRIPE_PRICE_ID=DUMMY_replace_with_real_stripe_price_id
# Webhook signing secret for POST /api/billing/webhook/stripe
# (checkout.session.completed event).
STRIPE_WEBHOOK_SECRET=DUMMY_replace_with_real_stripe_webhook_secret

# --- Razorpay (required when BILLING_PROVIDER=razorpay) ---
# Key id and key secret from the Razorpay dashboard (Account & Settings > API keys).
RAZORPAY_KEY_ID=DUMMY_replace_with_real_razorpay_key_id
RAZORPAY_KEY_SECRET=DUMMY_replace_with_real_razorpay_key_secret
# Webhook signing secret for POST /api/billing/webhook/razorpay
# (payment_link.paid event).
RAZORPAY_WEBHOOK_SECRET=DUMMY_replace_with_real_razorpay_webhook_secret
# Settlement currency for Razorpay amounts (optional; default INR).
RAZORPAY_CURRENCY=INR
